# Copy to .env for local development. Never commit .env.
# Values must not have a trailing newline or spaces.

# PostgreSQL. The default below matches docker-compose.yml.
# A plain postgresql:// URL (as Railway provides) is accepted too.
DATABASE_URL=postgresql+asyncpg://recruitdesk:recruitdesk@localhost:5433/recruitdesk

# Required secrets, at least 32 characters each. Generate each one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Keys the hashes of the access codes. Changing it makes every existing code
# invalid, so keep the production value in a password manager.
ACCESS_CODE_PEPPER=
# Signs the session cookie. Changing it ends every session.
SESSION_SECRET=

# Session cookies are only sent over HTTPS. Chrome and Firefox make an exception
# for http://localhost. Set to false only for local development in Safari.
COOKIE_SECURE=true

# Hours without activity after which a session ends.
SESSION_IDLE_HOURS=24

# Link shown with the "code used up" message, for example a LinkedIn profile URL.
# Leave empty to show the message without a link.
CONTACT_URL=

# Brute-force protection on the code entry screen.
FAILED_ATTEMPTS_PER_IP=10
FAILED_ATTEMPTS_WINDOW_MINUTES=15
FAILED_ATTEMPTS_GLOBAL_PER_HOUR=100
