# Copy to .env for local development. Never commit .env.
# Values must not have a trailing newline or spaces.

# PostgreSQL. The default below matches docker-compose.yml.
# A plain postgresql:// URL (as Railway provides) is accepted too.
DATABASE_URL=postgresql+asyncpg://recruitdesk:recruitdesk@localhost:5433/recruitdesk

# Required secrets, at least 32 characters each. Generate each one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Keys the hashes of the access codes. Changing it makes every existing code
# invalid, so keep the production value in a password manager.
ACCESS_CODE_PEPPER=
# Signs the session cookie. Changing it ends every session.
SESSION_SECRET=

# Session cookies are only sent over HTTPS. Chrome and Firefox make an exception
# for http://localhost. Set to false only for local development in Safari.
COOKIE_SECURE=true

# Hours without activity after which a session ends.
SESSION_IDLE_HOURS=24

# Link shown with the "code used up" message, for example a LinkedIn profile URL.
# Leave empty to show the message without a link.
CONTACT_URL=

# Brute-force protection on the code entry screen.
FAILED_ATTEMPTS_PER_IP=10
FAILED_ATTEMPTS_WINDOW_MINUTES=15
FAILED_ATTEMPTS_GLOBAL_PER_HOUR=100

# The model. "mistral" calls the real API and costs money. "fake" answers
# without the network and without cost: use it for development.
LLM_PROVIDER=fake
# Needed when LLM_PROVIDER=mistral. Never commit it and never paste it in a chat.
MISTRAL_API_KEY=
# An exact, pinned model version (no "-latest" alias). A model also needs a
# price in app/llm/pricing.py, or the app refuses to start.
MISTRAL_MODEL_VACANCY=mistral-small-2603
MISTRAL_MODEL_CV=mistral-small-2603
MISTRAL_MODEL_SCRIPT=mistral-small-2603
LLM_TIMEOUT_SECONDS=60
# How many CVs are written at the same time. Keep it low because of rate limits.
CV_CONCURRENCY=4
# Makes the fake model slow enough to see the spinner (seconds).
FAKE_LLM_DELAY_SECONDS=2

# How often one workspace may start a vacancy generation (retries count).
MAX_VACANCY_GENERATIONS_PER_WORKSPACE=10
# Candidates one workspace may generate in total, over all its vacancies.
MAX_CANDIDATES_PER_WORKSPACE=300
# How often one workspace may ask the model for a selection script.
MAX_SCRIPT_PROPOSALS_PER_WORKSPACE=20

# Seed for sampling candidate blueprints, so a pool can be reproduced.
BLUEPRINT_SEED=20261013

# The built frontend. The backend serves it when the folder exists.
FRONTEND_DIST=web/dist
